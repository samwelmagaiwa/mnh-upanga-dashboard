APP_NAME="Clinical Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://clinicaldashboard.mloganzila.or.tz

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=your-remote-db-host
DB_PORT=3306
DB_DATABASE=dashboard_live
DB_USERNAME=dashboard_user
DB_PASSWORD=change-me

CACHE_STORE=database
CACHE_PREFIX=clinicaldashboard-live
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=clinicaldashboard.mloganzila.or.tz
SESSION_COOKIE=clinicaldashboard_live_session
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=clinicaldashboard.mloganzila.or.tz

DASHBOARD_API_BASE_URL=http://192.168.235.250/labsms/swagger/mnh_dashboard
DASHBOARD_API_USERNAME=mnh-mlg-client
DASHBOARD_API_PASSWORD=change-me

# Gap detection calendar
# 0=Sunday, 6=Saturday
DASHBOARD_NON_OPERATIONAL_WEEKDAYS=0
# Comma-separated YYYY-MM-DD dates
DASHBOARD_EXCLUDED_DATES=
