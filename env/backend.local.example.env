APP_NAME="Clinical Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://clinicaldashboard.mloganzila.or.tz

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=your-remote-db-host
DB_PORT=3306
DB_DATABASE=dashboard_local
DB_USERNAME=dashboard_user
DB_PASSWORD=change-me

CACHE_STORE=database
CACHE_PREFIX=clinicaldashboard-local
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=clinicaldashboard.mloganzila.or.tz
SESSION_COOKIE=clinicaldashboard_local_session
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=clinicaldashboard.mloganzila.or.tz

DASHBOARD_API_BASE_URL=http://your-upstream-dashboard-api
DASHBOARD_API_USERNAME=
DASHBOARD_API_PASSWORD=

# Swagger — regenerate docs on every request in local dev
L5_SWAGGER_GENERATE_ALWAYS=true
