APP_NAME="Clinical Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Connects to the 'db' service defined in docker-compose.local.yml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dashboard
DB_USERNAME=dashboard
DB_PASSWORD=secret

# Use Redis for cache/queue/session (faster than database driver)
# 'redis' is the service name defined in docker-compose.local.yml
CACHE_STORE=redis
CACHE_PREFIX=dashboard-local
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_COOKIE=dashboard_local_session
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000

# HIS API — fill in real credentials
DASHBOARD_API_BASE_URL=http://192.168.235.250/labsms/swagger/mnh_dashboard
DASHBOARD_API_USERNAME=
DASHBOARD_API_PASSWORD=

# Gap detection calendar (0=Sunday, 6=Saturday)
DASHBOARD_NON_OPERATIONAL_WEEKDAYS=0
DASHBOARD_EXCLUDED_DATES=

# Regenerate Swagger docs on every request during local dev
L5_SWAGGER_GENERATE_ALWAYS=true
