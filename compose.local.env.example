COMPOSE_PROJECT_NAME=dashboard-local
IMAGE_TAG=local

BACKEND_IMAGE=samwelmagaiwa/dashboard-backend
FRONTEND_IMAGE=samwelmagaiwa/dashboard-frontend

# Points to the Docker-local env file (contains DB_HOST=db, REDIS_HOST=redis, etc.)
# Copy env/backend.docker.example.env → env/backend.docker.env and fill in credentials
BACKEND_ENV_FILE=./env/backend.docker.env
BACKEND_STORAGE_PATH=./dashboard-backend/storage

FRONTEND_PORT=3000
FRONTEND_SERVER_NAME=localhost
BACKEND_UPSTREAM=http://dashboard_backend:80
VITE_API_BASE_URL=/api/v1

RUN_MIGRATIONS=false
